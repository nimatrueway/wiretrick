{
    "name": "ResScript Override",
    "version": "2.0.0",
    "description": "Script-based request and response override: write TypeScript-style scripts that redirect, modify headers, or transform response bodies.",
    "icons": {
        "16": "icons/icon-16x16.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
    },
    "browser_action": {
        "default_title": "ResScript Manager",
        "default_icon": {
            "16": "icons/icon-16x16.png"
        }
    },
    "options_ui": {
        "page": "manager.html",
        "open_in_tab": true
    },
    "background": {
        "page": "background.html"
    },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["hook.js"],
            "all_frames": true,
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "storage",
        "unlimitedStorage",
        "tabs",
        "debugger",
        "<all_urls>"
    ],
    "web_accessible_resources": ["hook.js"],
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "strict_min_version": "115.0"
        }
    }
}

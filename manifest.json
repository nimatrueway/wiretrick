{
    "name": "TangiTweak",
    "version": "0.28.0",
    "version_name": "0.28.0-alpha",
    "description": "Override requests and responses with TypeScript scripts: redirect, change headers, mock or rewrite response bodies.",
    "icons": {
        "16": "icons/icon-16x16.png",
        "32": "icons/icon-32x32.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
    },
    "browser_action": {
        "default_title": "TangiTweak",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16x16.png",
            "32": "icons/icon-32x32.png"
        }
    },
    "options_ui": {
        "page": "editor.html",
        "open_in_tab": true
    },
    "background": {
        "page": "background.html",
        "persistent": true
    },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["bridge.js"],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "storage",
        "alarms",
        "unlimitedStorage",
        "tabs",
        "debugger",
        "proxy",
        "nativeMessaging",
        "browsingData",
        "declarativeNetRequestWithHostAccess",
        "<all_urls>"
    ],
    "optional_permissions": ["management"],
    "web_accessible_resources": ["hook.js", "overlay.html", "overlay.js", "builtins-react.js"],
    "sandbox": { "pages": ["overlay.html"] },
    "content_security_policy": "script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; object-src 'self'",
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "id": "tangitweak@tangistudio",
            "strict_min_version": "115.0"
        }
    }
}

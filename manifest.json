{
    "name": "Wiretrick",
    "version": "0.4.0",
    "description": "Script-based request and response override: write TypeScript-style scripts that redirect, modify headers, or transform response bodies.",
    "icons": {
        "16": "icons/icon-16x16.png",
        "32": "icons/icon-32x32.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
    },
    "browser_action": {
        "default_title": "Wiretrick Manager",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16x16.png",
            "32": "icons/icon-32x32.png"
        }
    },
    "options_ui": {
        "page": "manager.html",
        "open_in_tab": true
    },
    "background": {
        "page": "background.html",
        "persistent": true
    },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["hook.js"],
            "all_frames": true,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["*://*/*"],
            "js": ["bridge.js"],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "storage",
        "unlimitedStorage",
        "tabs",
        "debugger",
        "proxy",
        "nativeMessaging",
        "browsingData",
        "<all_urls>"
    ],
    "optional_permissions": ["management"],
    "web_accessible_resources": ["hook.js"],
    "content_security_policy": "script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; object-src 'self'",
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "id": "wiretrick@nimatrueway",
            "strict_min_version": "115.0"
        }
    }
}

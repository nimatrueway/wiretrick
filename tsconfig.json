{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
        "types": ["chrome"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}

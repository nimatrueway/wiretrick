{
  "name": "wiretrick",
  "version": "0.3.6",
  "description": "Script-based request/response override extension (TypeScript rewrite)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:helper": "cargo build --release --manifest-path helper/Cargo.toml",
    "test:helper": "cargo test --manifest-path helper/Cargo.toml",
    "test:e2e": "tsx test/e2e.ts",
    "test:e2e:samples": "tsx test/samples.e2e.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.0",
    "rolldown": "^1.0.0-beta.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "monaco-editor": "^0.52.0",
    "preact": "^11.0.1",
    "sucrase": "^3.35.1",
    "yaml": "^2.9.0"
  }
}
